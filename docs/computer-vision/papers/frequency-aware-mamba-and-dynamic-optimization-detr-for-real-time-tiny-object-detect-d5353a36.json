{
  "abstract_summary": "Abstract \u5b9e\u65f6\u5fae\u578b\u7269\u4f53\u63a2\u6d4b\u662f\u4f4e\u7a7a\u65e0\u4eba\u98de\u884c\u5668(UAV)\u611f\u77e5\u7684\u5173\u952e\u4efb\u52a1\u3002\u7136\u800c,\u7531\u4e8e\u6210\u50cf\u9ad8\u5ea6\u3001\u89c6\u89d2\u548c\u590d\u6742\u80cc\u666f\u7684\u53d8\u5316,\u7a7a\u4e2d\u76ee\u6807\u901a\u5e38\u4f53\u79ef\u5c0f\u3001\u5206\u5e03\u5bc6\u96c6\u4e14\u89c6\u89c9\u6a21\u7cca,\u4ece\u800c\u5bf9\u68c0\u6d4b\u7cbe\u5ea6\u548c\u63a8\u7406\u6548\u7387\u6784\u6210\u4e86\u5de8\u5927\u6311\u6218\u3002\u5c3d\u7ba1RT-DETR\u6846\u67b6\u63d0\u4f9b\u4e86\u7aef\u5230\u7aef\u7684\u68c0\u6d4b\u6a21\u5f0f,\u4f46\u5b83\u5bf9\u5fae\u5c0f\u7269\u4f53\u7684\u53cd\u5e94\u8f83\u5f31,\u7279\u5f81\u878d\u5408\u8fc7\u7a0b\u4e2d\u7ec6\u5fae\u7ec6\u8282\u7684\u9000\u5316,\u4ee5\u53ca\u65e0\u4eba\u673a\u573a\u666f\u4e2d\u4e0d\u7a33\u5b9a\u7684\u8fb9\u754c\u7bb1\u56de\u5f52\u3002\u4e3a\u5e94\u5bf9\u8fd9\u4e9b\u9650\u5236,\u6211\u4eec\u7684FAMO-DETR\u88ab\u5f15\u5165\u4e3a\u4e00\u79cd\u9891\u7387\u611f\u77e5\u7684\u7aef\u5230\u7aef\u63a2\u6d4b\u5668,\u4e13\u4e3a\u901a\u8fc7\u65e0\u4eba\u673a\u63a2\u6d4b\u5fae\u5c0f\u7269\u4f53\u800c\u8bbe\u8ba1\u3002\u5177\u4f53\u800c\u8a00,\u901a\u8fc7\u79bb\u6563\u7684\u5c0f\u6ce2\u53d8\u6362,\u5c06\u9891\u7387\u611f\u77e5\u7684Mamba\u7f16\u7801\u5668(FAME)\u8bbe\u8ba1\u7528\u4e8e\u5c06\u4f4e\u9891\u8bed\u4e49\u4fe1\u606f\u4e0e\u9ad8\u9891\u8fb9\u7f18\u7ec6\u8282\u5206\u79bb,\u4ece\u800c\u901a\u8fc7Mamba\u5e8f\u5217\u5efa\u6a21,\u589e\u5f3a\u6df1\u5ea6\u7279\u5f81\u4e2d\u7684\u5168\u5c40\u60c5\u5883\u8868\u793a\u3002\u968f\u540e\u5f00\u53d1\u51fa\u4e00\u79cd\u9ad8\u9891...",
